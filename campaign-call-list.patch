+{% extends "dashboard/base.html" %}
+{% block title %}Llamadas — Cobranzas IA{% endblock %}
+
+{% block content %}
+<div style="margin-bottom: 24px;">
+  <h1 style="font-size: 22px; font-weight: 700;">Llamadas</h1>
+  <p style="color: var(--muted); margin-top: 4px;">{{ page_obj.paginator.count }} llamada{{ page_obj.paginator.count|pluralize }}/mensaje{{ page_obj.paginator.count|pluralize }} en total</p>
+</div>
+
+<!-- FILTROS -->
+<form method="get" class="card" style="margin-bottom:16px; display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
+  <div style="flex:1; min-width:180px;">
+    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Buscar por cliente o teléfono</label>
+    <input type="text" name="q" value="{{ search }}" placeholder="Nombre o teléfono"
+      style="width:100%; background:var(--bg); border:1px solid var(--border); color:var(--text);
+             padding:8px 10px; border-radius:var(--radius); font-size:13px;">
+  </div>
+  <div>
+    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Estado</label>
+    <select name="status" style="background:var(--bg); border:1px solid var(--border); color:var(--text);
+             padding:8px 10px; border-radius:var(--radius); font-size:13px;">
+      <option value="">Todos</option>
+      {% for value, label in status_choices %}
+        <option value="{{ value }}" {% if status_filter == value %}selected{% endif %}>{{ label }}</option>
+      {% endfor %}
+    </select>
+  </div>
+  <div>
+    <label style="font-size:12px; color:var(--muted); display:block; margin-bottom:4px;">Canal</label>
+    <select name="channel" style="background:var(--bg); border:1px solid var(--border); color:var(--text);
+             padding:8px 10px; border-radius:var(--radius); font-size:13px;">
+      <option value="">Todos</option>
+      {% for value, label in channel_choices %}
+        <option value="{{ value }}" {% if channel_filter == value %}selected{% endif %}>{{ label }}</option>
+      {% endfor %}
+    </select>
+  </div>
+  <button type="submit" class="btn btn-secondary">Filtrar</button>
+  {% if search or status_filter or channel_filter %}
+    <a href="/calls/" class="btn btn-secondary">Limpiar</a>
+  {% endif %}
+</form>
+
+<!-- TABLA -->
+<div class="card">
+  {% if page_obj.object_list %}
+  <table>
+    <thead>
+      <tr>
+        <th>Cliente</th>
+        <th>Teléfono</th>
+        <th>Campaña</th>
+        <th>Canal</th>
+        <th>Estado</th>
+        <th>Duración</th>
+        <th>Resultado</th>
+        <th>Fecha</th>
+      </tr>
+    </thead>
+    <tbody>
+      {% for call in page_obj.object_list %}
+      <tr>
+        <td style="font-weight: 500;">{{ call.client.first_name }} {{ call.client.last_name }}</td>
+        <td style="color: var(--muted);">{{ call.client.phone }}</td>
+        <td><a href="/campaigns/{{ call.batch.id }}/" style="color: var(--accent); text-decoration:none;">{{ call.batch.name }}</a></td>
+        <td>{% if call.channel == 'whatsapp' %}💬 WhatsApp{% else %}📞 Llamada{% endif %}</td>
+        <td><span class="badge badge-{{ call.status }}">{{ call.get_status_display }}</span></td>
+        <td style="color: var(--muted);">
+          {% if call.channel == 'whatsapp' %}—{% elif call.duration %}{{ call.duration }}s{% else %}—{% endif %}
+        </td>
+        <td style="color: var(--muted);">{{ call.outcome|default:"—" }}</td>
+        <td style="color: var(--muted);">{{ call.created_at|date:"d/m/Y H:i" }}</td>
+      </tr>
+      {% endfor %}
+    </tbody>
+  </table>
+  {% else %}
+  <p style="color: var(--muted); text-align:center; padding:32px 0;">No hay llamadas que coincidan con el filtro.</p>
+  {% endif %}
+</div>
+
+<!-- PAGINACIÓN -->
+{% if page_obj.paginator.num_pages > 1 %}
+<div style="display:flex; justify-content:center; gap:8px; margin-top:16px;">
+  {% if page_obj.has_previous %}
+    <a class="btn btn-secondary btn-sm" href="?page={{ page_obj.previous_page_number }}{% if search %}&q={{ search }}{% endif %}{% if status_filter %}&status={{ status_filter }}{% endif %}{% if channel_filter %}&channel={{ channel_filter }}{% endif %}">← Anterior</a>
+  {% endif %}
+  <span style="color:var(--muted); font-size:13px; align-self:center;">Página {{ page_obj.number }} de {{ page_obj.paginator.num_pages }}</span>
+  {% if page_obj.has_next %}
+    <a class="btn btn-secondary btn-sm" href="?page={{ page_obj.next_page_number }}{% if search %}&q={{ search }}{% endif %}{% if status_filter %}&status={{ status_filter }}{% endif %}{% if channel_filter %}&channel={{ channel_filter }}{% endif %}">Siguiente →</a>
+  {% endif %}
+</div>
+{% endif %}
+{% endblock %}
