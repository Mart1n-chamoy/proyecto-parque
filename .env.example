# Environment configuration file
# Copy this to .env and fill in your values

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DB_NAME=cobranza_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id
ELEVENLABS_PHONE_NUMBER_ID=your-elevenlabs-phone-number-id
ELEVENLABS_WHATSAPP_PHONE_NUMBER_ID=950693464804211

# Tool "enviar_enlace_pago": secreto compartido para que solo ElevenLabs
# pueda llamar a /webhooks/send-payment-link/ (generar uno propio, no reusar este)
ELEVENLABS_TOOL_SECRET=cambiar-por-un-valor-random-unico
# Nombre del template de WhatsApp aprobado en Meta con el link de pago (estático, sin variables)
WHATSAPP_PAYMENT_LINK_TEMPLATE=enlace_pago_cobranzas

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
